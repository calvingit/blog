---
import { HEADER, SITE } from '@constants'
import Spacer from './spacer.astro'
import Link from './link.astro'
import Search from './search.astro'

const { pathname } = Astro.url
const isActive = (url: string) => pathname === url
const isWeeklyRoute = pathname.startsWith('/weekly/')
---

<header class="container">
  <Spacer axis="vertical" size={8} />
  <div class="flex flex-row justify-between items-center">
    <div>
      <a
        class="font-semibold text-xl md:text-2xl lg:text-3xl text-highlight"
        href="/"
        aria-label={`${SITE.title} - Back to home`}>{SITE.title}</a
      >
    </div>
    <Search />
  </div>
  <Spacer axis="vertical" size={6} />
  <div class="flex flex-row justify-between items-center border-b border-border pb-4 text-lg md:text-xl">
    <nav aria-label="Primary navigation" class="flex gap-4">
      {
        HEADER.internal.map((link) =>
          'links' in link ? (
            <div class="group relative">
              <button
                type="button"
                class:list={[
                  'flex cursor-pointer items-center gap-1 text-subtle hover:text-highlight',
                  isWeeklyRoute && 'text-highlight',
                ]}
                aria-haspopup="true"
              >
                {link.title}
                <svg
                  aria-hidden="true"
                  class="size-4"
                  viewBox="0 0 16 16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path d="m4 6 4 4 4-4" />
                </svg>
              </button>
              <div class="invisible pointer-events-none absolute top-full left-0 z-10 pt-2 opacity-0 transition-opacity group-hover:visible group-hover:pointer-events-auto group-hover:opacity-100 group-focus-within:visible group-focus-within:pointer-events-auto group-focus-within:opacity-100">
                <div class="min-w-64 border border-border bg-bg py-2 shadow-lg">
                  {link.links.map((item) => (
                    <Link
                      href={item.url}
                      class:list={[
                        'block px-4 py-2 whitespace-nowrap hover:no-underline hover:bg-border',
                        isActive(item.url) && 'active',
                      ]}
                      aria-current={isActive(item.url) ? 'page' : 'false'}
                    >
                      {item.title}
                    </Link>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <Link
              href={link.url}
              class={isActive(link.url) ? 'active' : ''}
              aria-current={isActive(link.url) ? 'page' : 'false'}
            >
              {link.title}
            </Link>
          ),
        )
      }
    </nav>
    <div class="flex gap-4">
      {
        HEADER.external.map((link) => (
          <Link href={link.url} {...link.props}>
            {link.title}
          </Link>
        ))
      }
    </div>
  </div>
  <Spacer axis="vertical" size={16} />
</header>
