---
import { HEADER, SITE } from '@constants'
import Link from './link.astro'
import Search from './search.astro'

const { pathname } = Astro.url
const isActive = (url: string) => pathname === url
const isWeeklyRoute = pathname.startsWith('/weekly/')
---

<header class="container relative">
  <div class="flex flex-wrap items-center gap-x-8 gap-y-4 border-b border-border py-6">
    <a
      class="order-1 shrink-0 text-xl font-semibold tracking-tight text-highlight md:text-2xl"
      href="/"
      aria-label={SITE.title + ' - Back to home'}
    >{SITE.title}</a>
    <nav aria-label="Primary navigation" class="order-3 flex w-full flex-wrap items-center gap-x-6 gap-y-2 text-base lg:order-2 lg:w-auto lg:flex-1">
      {
        HEADER.internal.map(link =>
          'links' in link ? (
            <div class="group relative max-sm:static">
              <button
                type="button"
                class:list={[
                  'flex cursor-pointer items-center gap-1 text-subtle hover:text-highlight',
                  isWeeklyRoute && 'text-highlight',
                ]}
                aria-haspopup="true"
              >
                {link.title}
                <svg aria-hidden="true" class="size-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="m4 6 4 4 4-4" />
                </svg>
              </button>
              <div class="invisible pointer-events-none absolute left-0 top-full z-20 pt-2 opacity-0 transition-opacity group-hover:visible group-hover:pointer-events-auto group-hover:opacity-100 group-focus-within:visible group-focus-within:pointer-events-auto group-focus-within:opacity-100 max-sm:right-0">
                <div class="min-w-64 border border-border bg-bg py-2 shadow-lg max-sm:min-w-0">
                  {link.links.map(item => (
                    <Link
                      href={item.url}
                      class:list={[
                        'block px-4 py-2 whitespace-nowrap hover:bg-border hover:no-underline max-sm:whitespace-normal',
                        isActive(item.url) && 'active',
                      ]}
                      aria-current={isActive(item.url) ? 'page' : undefined}
                    >
                      {item.title}
                    </Link>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <Link
              href={link.url}
              class={isActive(link.url) ? 'active' : ''}
              aria-current={isActive(link.url) ? 'page' : undefined}
            >
              {link.title}
            </Link>
          ),
        )
      }
    </nav>
    <div class="order-2 ml-auto flex shrink-0 items-center gap-4 lg:order-3">
      <Search />
      <div class="hidden items-center gap-4 border-l border-border pl-4 text-sm sm:flex">
        {HEADER.external.map(link => (
          <Link href={link.url} {...link.props} rel="noopener noreferrer">
            {link.title}
          </Link>
        ))}
      </div>
    </div>
  </div>
  <div class="h-10 md:h-12" aria-hidden="true"></div>
</header>
