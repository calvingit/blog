---
import Link from './link.astro'
import ThemeSelect from './theme-select.astro'
import { SITE } from '@constants'
---

<footer class="container">
  <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-4 border-t border-border py-8 text-sm">
    <div class="font-medium text-highlight">
      {SITE.title} <span class="font-normal text-faded">/ zhangwen.site</span>
    </div>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
      <Link href="https://github.com/calvingit" target="_blank" rel="noopener noreferrer">GitHub</Link>
      <Link href="https://x.com/calvin_cheung0" target="_blank" rel="noopener noreferrer">X</Link>
      <Link href="/rss.xml">RSS Feed</Link>
      <span aria-hidden="true" class="h-4 w-px bg-border"></span>
      <ThemeSelect />
    </div>
    <span class="text-faded">© {new Date().getFullYear()} Calvin</span>
  </div>
</footer>
