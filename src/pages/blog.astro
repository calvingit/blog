---
import Layout from '@layouts/layout.astro'
import Seo from '@components/seo.astro'
import { getCollection } from 'astro:content'
import SkipNavContent from '@components/a11y/skip-nav-content.astro'
import { defaultDateFormat, sortAsc } from '@utils'
import Spacer from '@components/spacer.astro'
import JsonLd from '@components/json-ld.astro'
import Link from '@components/link.astro'
import { collectionGraph } from '../schema'

const posts = sortAsc(await getCollection('blog'))
const description = '张文的技术文章。'
---

<Layout>
  <Seo slot="seo" title="博客" description={description}>
    <JsonLd
      data={collectionGraph({
        name: '博客',
        description,
        path: '/blog/',
        crumbs: [
          { name: '首页', path: '/' },
          { name: '博客', path: '/blog/' },
        ],
      })}
    />
  </Seo>
  <SkipNavContent>
    <h1 class="sr-only">Blog</h1>
    <div class="flex gap-10 flex-col">
      {
        posts.map(({ data: post }) => (
          <div>
            <Link variant="highlight" class="font-medium" href={`/blog/${post.slug}/`}>
              {post.title}
            </Link>
            <Spacer axis="vertical" size={2} />
            <div class="text-faded">
              {defaultDateFormat(post.date)} — {post.tags.join(', ')}
            </div>
            <Spacer axis="vertical" size={4} />
            <div class="text-subtle text-md md:text-lg">{post.description}</div>
          </div>
        ))
      }
    </div>
  </SkipNavContent>
</Layout>
