---
import { SITE } from '@constants'
import SkipNavLink from '@components/a11y/skip-nav-link.astro'
import Header from '@components/header.astro'
import Footer from '@components/footer.astro'
import JsonLd from '@components/json-ld.astro'
import ThemeProvider from '@components/theme-provider.astro'
import { websiteGraph } from '../schema'
import '@styles/global.css'

const isHome = Astro.url.pathname === '/'
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <ThemeProvider />
    <slot name="seo" />
    {isHome && <JsonLd data={websiteGraph()} />}
  </head>
  <body class="min-h-screen bg-bg text-text">
    <SkipNavLink />
    <Header />
    <slot />
    <Footer />
  </body>
</html>
